# ---- 构建产物 ----
# trunk 的产物（plugin.json 的 entry 指向 dist/index.html），本地构建，不入库
dist/
dist-pack/
target/
**/target/

# ---- 依赖 ----
node_modules/

# ---- 编辑器 / 系统 ----
.DS_Store
Thumbs.db
*.swp

# ---- 本地日志 ----
*.log

# playwright-cli 本地调试的临时输出
.playwright-cli/

# ---- 上游源码 ----
# 已迁到 upstream.pin + 按需拉取，不再随仓库分发
/upstream/

# ---- native 适配层的构建产物 ----
# 由发布流水线产物按宿主约定命名为 lib/{macOS.dylib,Windows.dll,Linux.so}，不进 git。
native/target/
*.dylib
*.dll
*.so
