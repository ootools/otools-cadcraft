+/// 宿主 shell 注入的额外 fallback 字体（键, 字节）；wasm 读不到系统字体。
+static EXTRA_FALLBACK_FONTS: std::sync::OnceLock<Vec<(String, std::sync::Arc<egui::FontData>)>> = std::sync::OnceLock::new();
+pub fn set_extra_fallback_fonts(fonts: Vec<(String, std::sync::Arc<egui::FontData>)>) {
+    let _ = EXTRA_FALLBACK_FONTS.set(fonts);
