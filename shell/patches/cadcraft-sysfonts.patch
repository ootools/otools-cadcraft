+/// OTools 宿主字体桥（wasm）：宿主枚举系统字体，字节按需经宿主桥读入。
+///
+/// wasm 里没有文件系统，上游的字体扫描恒空；OTools 宿主能枚举并读系统字体，于是
+/// 「文档内容字体」不再局限于内嵌字体：宿主给目录（[`set_system_catalog`]），应用
+/// 第一次用到某个字体时该文件进待读队列（[`take_pending_fonts`]），外壳读回字节后
+/// [`register_host`] 装进库，之后按族名/文件名都能找到（缓存已清）。
+#[cfg(target_arch = "wasm32")]
+pub mod host_bridge {
+    use std::sync::{Mutex, PoisonError};
+
+    use super::{Fallback, Source, lock};
+
+    /// A system font face the OTools host listed: family/style for the font menus,
+    /// path + face index for reading its bytes over the host bridge.
+    #[derive(Clone, Debug)]
+    pub struct SystemFont {
+        pub family: String,
+        pub style: String,
+        pub path: String,
+        pub index: u32,
+    }
+
+    /// Font files the app asked for, waiting for their bytes: (path, face index).
+    static PENDING: Mutex<Vec<(String, u32)>> = Mutex::new(Vec::new());
+
+    /// Most files one round of lookups may queue. A family-name lookup can name up to
+    /// `MAX_FAMILY_FILES + MAX_FIRST_WORD_FILES` candidates, and a missing-glyph search
+    /// walks the whole ranked list; the shell reads what fits, best candidates first.
+    const MAX_PENDING: usize = 64;
+
+    /// Remember that `path`'s face `index` is wanted (deduplicated, bounded).
+    pub(super) fn push_pending(path: String, index: u32) {
+        let mut q = PENDING.lock().unwrap_or_else(PoisonError::into_inner);
+        if q.len() >= MAX_PENDING || q.iter().any(|(p, i)| *p == path && *i == index) {
+            return;
+        }
+        q.push((path, index));
+    }
+
+    /// Take the font files asked for since the last call; the shell reads their bytes
+    /// over the host bridge and hands them to [`register_host`].
+    pub fn take_pending_fonts() -> Vec<(String, u32)> {
+        std::mem::take(&mut *PENDING.lock().unwrap_or_else(PoisonError::into_inner))
+    }
+
+    /// Lower-case file stem of a font path (`C:\Fonts\NotoSansSC-Bold.ttf` →
+    /// `notosanssc-bold`): the key font files are known by, the same key a native
+    /// scan derives from the file name.
+    fn stem_of(path: &str) -> String {
+        let name = path.rsplit(['\\', '/']).next().unwrap_or(path);
+        let stem = name.rsplit_once('.').map_or(name, |(s, _)| s);
+        stem.chars().map(|c| c.to_ascii_lowercase()).collect()
+    }
+
+    /// Feed the host's system font catalog: every listed face becomes a known font file
+    /// whose bytes are read on demand. Replaces a previous catalog and retries cached
+    /// misses, so fonts that arrive late still resolve.
+    pub fn set_system_catalog(fonts: Vec<SystemFont>) {
+        let mut g = lock();
+        for f in &fonts {
+            // 同一文件的多个面（.ttc）共享 stem：先到先得，与原生扫描一致；其余面仍可按
+            // 族名找到（by_family 会检查文件里每个面的名字）。
+            g.paths.entry(stem_of(&f.path)).or_insert_with(|| Source::Host { path: f.path.clone(), index: f.index });
+        }
+        g.host = fonts;
+        g.resolved.clear();
+        g.fallback = Fallback::default();
+    }
+
+    /// Register font bytes the host read for `path`: the file becomes loadable and cached
+    /// lookups are retried, so the next layout uses the real font. Past
+    /// [`super::MAX_LOADED_BYTES`] the file is dropped, like a native scan past the bound:
+    /// the name stays unresolved (and cached), so it is not read again.
+    pub fn register_host(path: &str, bytes: Vec<u8>) {
+        let mut g = lock();
+        if g.loaded_bytes >= super::MAX_LOADED_BYTES {
+            return;
+        }
+        g.loaded_bytes = g.loaded_bytes.saturating_add(bytes.len());
+        g.files.insert(stem_of(path), std::sync::Arc::new(bytes));
+        g.resolved.clear();
+        g.fallback = Fallback::default();
+    }
+
+    /// Family names the host listed, deduplicated in listing order (the font menus).
+    pub fn system_families() -> Vec<String> {
+        let mut out: Vec<String> = Vec::new();
+        for f in &lock().host {
+            if !f.family.trim().is_empty() && !out.iter().any(|x| x.eq_ignore_ascii_case(&f.family)) {
+                out.push(f.family.clone());
+            }
+        }
+        out
+    }
+}
